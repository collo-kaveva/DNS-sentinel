# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://dns_sentinel:dns_sentinel@localhost:5432/dns_sentinel

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# DNS Intelligence
DNS_RESOLVER_TIMEOUT=5
DNS_RESOLVER_LIFETIME=10
DNS_DEFAULT_RESOLVERS=1.1.1.1,8.8.8.8

# Rate limiting / safety
SCAN_MAX_CONCURRENT_TARGETS=5
SCAN_REQUEST_DELAY_SECONDS=1
HTTP_OBSERVATION_TIMEOUT=8

# Optional: certificate transparency / passive DNS provider keys
# Leave blank to disable — the app degrades gracefully and marks
# historical data as unavailable rather than faking it.
CRTSH_ENABLED=True
